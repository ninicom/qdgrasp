#!/usr/bin/env bash
set -euo pipefail

message_file="$1"
subject="$(sed -n '1p' "$message_file")"

if [[ "$subject" =~ ^Merge[[:space:]] ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|test|refactor|perf|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{3,72}$'
if [[ ! "$subject" =~ $pattern ]]; then
  printf '%s\n' \
    "Commit message không hợp lệ: $subject" \
    "Dùng Conventional Commit, ví dụ: feat(parser): add YAML registry" >&2
  exit 1
fi
